# Copy to `.env.local` to override locally (that file is git-ignored).

# --- Development (npm run dev) ---
# The dev server proxies /api and /uploads to this backend URL.
# Change the port if something else already uses 8080 on your machine
# (start the backend with PORT=8081 ./mvnw spring-boot:run and set this to http://localhost:8081).
VITE_BACKEND_URL=http://localhost:8080

# --- Production build (npm run build) ---
# Full URL of the deployed backend. Leave empty when the frontend is served from the same domain.
# VITE_API_URL=https://agora-platform.onrender.com
